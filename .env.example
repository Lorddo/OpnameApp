# =============================================================================
# OpnameApp — lokale env (kopieer naar .env en vul in)
# Secrets nooit committen. Waarden komen uit Supabase + Cloudflare dashboards.
# =============================================================================

# --- App ---
VITE_APP_NAME=OpnameApp
VITE_APP_ENV=development

# Publieke API-base. Lokaal leeg laten: Vite proxyt /api → worker :8787.
# In productie (same-origin PWA worker) ook leeg laten.
VITE_API_BASE_URL=

# --- Supabase (Project Settings → API Keys) ---
# Gebruik de nieuwe publishable key (sb_publishable_...).
# Legacy anon JWT werkt nog tot eind 2026, maar is niet meer de standaard.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optioneel alias (zelfde waarde als publishable); liever niet meer gebruiken
VITE_SUPABASE_ANON_KEY=

# Project ref (Settings → General → Reference ID) — handig voor CLI/links
SUPABASE_PROJECT_REF=
# Secret key (sb_secret_...) of legacy service_role — ALLEEN Workers/server
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret — lokale/dev fallback; Workers prefereren JWKS (fase 1)
SUPABASE_JWT_SECRET=

# Invite redirect (PWA auth callback) — allowlist in Supabase Auth → URL Configuration
INVITE_REDIRECT_URL=http://localhost:5173/auth/callback

# --- Cloudflare (Workers / R2) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# R2 bucket naam, bv. opnameapp
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
VITE_R2_PUBLIC_BASE_URL=
