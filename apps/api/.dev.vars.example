# =============================================================================
# Cloudflare Workers secrets (lokaal)
# Kopieer naar apps/api/.dev.vars — Wrangler laadt dit automatisch bij `wrangler dev`.
# Productie: `wrangler secret put <NAME>` (niet in git).
# =============================================================================

# Supabase
SUPABASE_URL=
# Preferred new keys:
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases (optional if the new keys above are set):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Prefer JWKS validation; secret kept for local/dev fallback
SUPABASE_JWT_SECRET=

# Optional: CORS origin for local Vite (production is same-origin via PWA worker)
CORS_ORIGIN=http://127.0.0.1:5173

# Invite / recovery redirect — must be allowlisted in Supabase Auth → URL Configuration
INVITE_REDIRECT_URL=http://localhost:5173/auth/callback

# Outbound webhooks (empty URL = disabled)
# WEBHOOK_URL=https://dashboard.example/hooks/opname
# WEBHOOK_SECRET=replace-with-shared-hmac-secret
# PUBLIC_API_BASE_URL=https://opnameapp-api.<account>.workers.dev
