{
  "name": "@opnameapp/pwa",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "preview:offline": "pnpm build && vite preview --host 127.0.0.1 --port 4173",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "^5.3.0",
    "@opnameapp/core": "workspace:*",
    "@supabase/supabase-js": "2.55.0",
    "@vueuse/core": "^13.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.4",
    "lucide-vue-next": "^0.539.0",
    "pinia": "^3.0.3",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.3.1",
    "uuid": "^14.0.1",
    "vue": "^3.5.18",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250812.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vite-plugin-pwa": "^1.0.2",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5",
    "wrangler": "^4.30.0"
  }
}
