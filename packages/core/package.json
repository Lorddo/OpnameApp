{
  "name": "@opnameapp/core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./template-schema": {
      "types": "./dist/template-schema.d.ts",
      "import": "./dist/template-schema.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "validate:templates": "tsx src/cli/validate-templates.ts"
  },
  "dependencies": {
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
