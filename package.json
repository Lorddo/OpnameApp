{
  "name": "opnameapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @opnameapp/pwa --filter @opnameapp/api dev",
    "dev:pwa": "pnpm --filter @opnameapp/pwa dev",
    "dev:api": "pnpm --filter @opnameapp/api dev",
    "build": "pnpm -r --filter @opnameapp/core --filter @opnameapp/api --filter @opnameapp/pwa build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r --filter @opnameapp/core --filter @opnameapp/api --filter @opnameapp/pwa typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:templates": "pnpm --filter @opnameapp/core validate:templates",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.1",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0"
  }
}
