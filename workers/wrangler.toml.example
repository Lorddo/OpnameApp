# =============================================================================
# Cloudflare Workers config
# Kopieer naar workers/wrangler.toml en vul account_id + bucket in.
# Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
# =============================================================================

name = "opnameapp-api"
main = "src/index.ts"
compatibility_date = "2026-08-01"

# Dashboard → Workers & Pages → Account ID
account_id = "VUL_CLOUDFLARE_ACCOUNT_ID_IN"

# Lokaal: wrangler dev — productie: wrangler deploy
workers_dev = true

# R2 binding (naam in code: env.PHOTOS_BUCKET)
[[r2_buckets]]
binding = "PHOTOS_BUCKET"
bucket_name = "VUL_R2_BUCKET_NAME_IN"
preview_bucket_name = "VUL_R2_BUCKET_NAME_IN"

# Optioneel later: KV / D1 / Queues hier toevoegen
