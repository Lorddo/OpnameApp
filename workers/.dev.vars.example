# =============================================================================
# Cloudflare Workers secrets (lokaal)
# Kopieer naar workers/.dev.vars — Wrangler laadt dit automatisch bij `wrangler dev`.
# Productie: `wrangler secret put <NAME>` (niet in git).
# =============================================================================

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# R2 (als je niet alleen via wrangler binding werkt)
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
